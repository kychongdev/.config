// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": "Material Icon Theme",
  "project_panel": {
    "dock": "left",
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "format_on_save": "on",
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "base_keymap": "JetBrains",
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "theme": "Gruvbox Dark",
  "languages": {
    "PHP": {
      "language_servers": ["intelephense", "!phpactor"],
      // run laravel pint on save
      "formatter": {
        "external": {
          "command": "bash",
          "arguments": [
            "-c",
            "cat > {buffer_path} && ./vendor/bin/pint --quiet {buffer_path} && cat {buffer_path}",
          ],
        },
      },
    },
  },
  "file_types": {
    "PHP": ["*.php", "_ide_helper.php"],
    "Blade": ["*.blade.php"],
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
  ],
  "theme_overrides": {
    "Gruvbox Dark": {
      "background.appearance": "transparent",
      // "background": "#4c464290",
      "background": "#00000060",
      "editor.background": "#00000030",
      "editor.gutter.background": "#00000030",
      "tab_bar.background": "#00000030",
      "terminal.background": "#00000030",
      "toolbar.background": "#00000030",
      "tab.active_background": "#28282820",
      "tab.inactive_background": "#00000000",
      "status_bar.background": "#00000030",
      "title_bar.background": "#00000030",
      "panel.background": "#00000000",
      // "element.hover": "#00000090",
      "border.variant": "#00000000",
      "scrollbar.track.border": "#00000000",
      "editor.active_line.background": "#00000000",
    },
  },
}
